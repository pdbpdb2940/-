{
  "entities": {
    "Shift": {
      "title": "Shift",
      "description": "早出シフト情報",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "staffName": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "note": { "type": "string" },
        "isAbsence": { "type": "boolean" },
        "absenceType": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedByName": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "date", "staffName", "startTime", "endTime"]
    },
    "TaskSchedule": {
      "title": "TaskSchedule",
      "description": "業務予定情報",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "staffName": { "type": "string" },
        "note": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedByName": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "date", "title", "time", "staffName"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "管理者用操作・変更履歴ログ",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string", "enum": ["create", "update", "delete"] },
        "targetType": { "type": "string", "enum": ["shift", "task"] },
        "targetDate": { "type": "string" },
        "targetSummary": { "type": "string" },
        "userUid": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "action", "targetType", "targetDate", "targetSummary", "userUid", "userName", "timestamp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "ユーザーカスタム姓情報",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "surname": { "type": "string" },
        "email": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "surname"]
    },
    "Staff": {
      "title": "Staff",
      "description": "職員マスタ情報",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "colorBg": { "type": "string" },
        "colorText": { "type": "string" },
        "colorBorder": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "管理者設定および月別メモ",
      "type": "object",
      "properties": {
        "adminPin": { "type": "string" },
        "notes": { "type": "object" },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/shifts/{shiftId}": {
      "schema": { "$ref": "#/entities/Shift" },
      "description": "早出シフトレコードコレクション"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskSchedule" },
      "description": "業務予定コレクション"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "操作・編集履歴監査ログコレクション"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "ユーザー別設定コレクション"
    },
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/Staff" },
      "description": "職員名簿コレクション"
    },
    "/configs/{configId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "システム設定・月別申し送りメモコレクション"
    }
  }
}
